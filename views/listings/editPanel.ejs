<% layout('./layout/boilerplate') -%>

    <body>
        <div class="row">
            <div class="col-8">
                <br><br>
                <h3>Edit your List</h3>
                <form action="/listing/<%= list._id%>?_method=PUT" method="POST"enctype="multipart/form-data" novalidate class="needs-validation" >
                    <!-- title  -->
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input name="listing[title]" class="form-control" value="<%=list.title%>" required>
                        <div class="invalid-feedback">
                            Please enter title
                        </div>
                    </div>
                    <!-- description  -->
                    <div class="mb-3">
                        <label class="form-label" for="description">Description </label>
                        <input name="listing[description]" class="form-control" value="<%=list.description%>" required>
                        <div class="invalid-feedback">
                            Please enter Description
                        </div>
                    </div>
                    <!-- Image url/link  -->
                     <div>
                        <img src="<%= originalImageUrl %>">
                     </div>
                    <div class="mb-3">
                        <label for="url" class="form-label">Upload Image</label>
                        <input name="listing[image]"  id="url" type="file" class="form-control">
                        <div class="valid-feedback">
                           Select File.
                        </div>
                    </div>
                    <div class="row">
                        <!-- location  -->
                        <div class="col-4 mb-3">
                            <label class="form-label " for="location">Location</label>
                            <input name="listing[location]" value="<%=list.location%>" class="form-control" required>
                            <div class="invalid-feedback">
                                Please enter Location
                            </div>
                        </div>
                        <!-- country  -->
                        <div class="col-8 mb-3">
                            <label class="form-label" for="country">Country</label>
                            <input name="listing[country]" value="<%=list.country%>" class="form-control" required>
                            <div class="invalid-feedback">
                                Please enter Country name
                            </div>
                        </div>
                    </div>
                    <!-- price  -->
                    <div class="mb-3">
                        <label class="form-label" for=price> Price</label>
                        <input name="listing[price]" type="number" value="<%=list.price%>" class="form-control" required>
                        <div class="invalid-feedback">
                            Please enter Price
                        </div>
                    </div>
                    <button class="btn edit-btn text-white">Edit</button>
                </form>
                <br><br>
            </div>
        </div>
    </body>