<% layout('./layout/boilerplate') -%>

    <body>
        <div id="filters">
            <div class="filter">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic city</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Moutains</p>
            </div>
            <div class="filter">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castels</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-tractor"></i></div>
                <p>Arctics</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-snowplow"></i></div>
                <p>Farms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-igloo"></i></div>
                <p>Domes</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-ship"></i></div>
                <p>Boats</p>
            </div>
            <div class="form-check form-switch tax-btn">
                <input class="form-check-input" type="checkbox" role="switch" id="toggel-btn">
                <label class="form-check-label" for="toggel-btn">Show After Taxes</label>
            </div>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 ">
                <%for (let list of listingData){%>
                    <div class="card" style="width: 20rem;height:15rem; margin-bottom:2rem">
                        <div class="favourite-text">Guest favourite</div>
                        <span id="favourite-box">&#9825;</span>
                        <a href="/listing/<%= list._id%>">
                            <!-- listing image  -->
                            <img src="<%= list.image.url%>" class="card-img-top" alt="<%= list.image.filename%>"
                                style="height: 12rem;">
                            <div class="card-body">
                                <p class="card-text">
                                    <!-- listing title  -->
                                    <b>
                                        <%= list.title%>
                                    </b>
                                    <br>
                                    <!-- listing price  -->
                                    &#x20B9;<%= list.price.toLocaleString("en-IN")%> /night
                                       &nbsp; <i class="gst-tag">+18% GST</i>
                                </p>
                            </div>
                        </a>
                    </div>
                    <% }%>
            </div>
    </body>