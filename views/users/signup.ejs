<% layout('./layout/boilerplate') -%>

    <body>

        <div class="row">
            <div class="col-6 ">
                <br><br>
                <h1>SignUp on Wanderlust</h1>
                <form action="/signup" method="POST" class="mb-5 needs-validation" novalidate>

                    <!-- username  -->
                    <div class="mb-3 ">
                        <label for="username" class="form-label">username</label>
                        <input name="username" placeholder="@username" id="username" type="text"
                            class="form-control" required>
                        <div class="invalid-feedback">
                            create username
                        </div>
                    </div>

                    <!-- email  -->
                    <div class="mb-3">
                        <label for="mail" class="form-label">Email</label>
                        <input name="email" placeholder="alex@gmail.com" id="mail" type="text"
                            class="form-control" required>
                            <div class="invalid-feedback">
                                please enter email
                            </div>
                    </div>


                    <!-- password  -->
                    <div class="mb-3">
                        <label for="title" class="form-label">Password</label>
                        <input name="password" placeholder="Strong PassWord" id="password" type="password"
                            class="form-control" required>
                            <div class="invalid-feedback">
                                please choose your password
                            </div>
                    </div>

                    <!-- button  -->
                    <button class="btn bg-black text-white">Sign UP</button>
                </form>
            </div>
        </div>
    </body>